<core:FragmentDefinition xmlns:core = "sap.ui.core"
    xmlns = "sap.m">

    <Panel id="pAccountDetails" expandable="false" width="auto" class="sapUiResponsiveMargin">
    <!-- headerText="Account Details"         - Removed as per the requirments -->
        <content>
            <HBox id="hBox4">
                <Avatar id="aUserProfile" src="{/profile}" displaySize="XL" showBorder="true" press=".onPress"/>
                <VBox id="vBox1" binding="{oBankDetails>/accountDetails}" class="sapUiSmallMargin sapUiLargeMarginBegin">
                    <!-- <Title id="accDetails" text="{i18n>accDetails}" /> -->
                    <HBox id="hBox1">
                        <Label id="lblAccnumber" text="{i18n>accNumber}" class="sapUiSmallMarginEnd"/>
                        <Text id="accval" text="{oBankDetails>accountNmbr}" />
                    </HBox>
                    <HBox id="hBox12">
                        <Label id="lblAccHolderName" text="{i18n>accHolderName}" class="sapUiSmallMarginEnd"/>
                        <Text id="accountHolderNameVal" text="{oBankDetails>name}" />
                    </HBox>
                    <HBox id="hBox3">
                        <Label id="lblIfsc" text="{i18n>iFSCode}" class="sapUiSmallMarginEnd"/>
                        <Text id="ifscVal" text="{oBankDetails>ifsc}" />
                    </HBox>
                    <Button id="openBankDetails" type="Neutral" text="{i18n>findMoreBtn}" press=".onOpenBankDetails" class="sapUiSmallMarginTop"/>
                </VBox>
            </HBox>
        </content>
    </Panel>
</core:FragmentDefinition>
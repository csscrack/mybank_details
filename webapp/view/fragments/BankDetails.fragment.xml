<core:FragmentDefinition xmlns:core = "sap.ui.core"
    xmlns = "sap.m">

    <Panel id="pAccountDetails" expandable="false" headerText="Account Details" width="auto" class="sapUiResponsiveMargin">
        <content>
            <HBox id="hBox4">
                <Avatar id="aUserProfile" src="" displaySize="XL" showBorder="true" press=".onPress"/>
                <VBox id="vBox1" class="sapUiSmallMargin sapUiLargeMarginBegin">
                    <!-- <Title id="accDetails" text="{i18n>accDetails}" /> -->
                    <HBox id="hBox1">
                        <Label id="lblAccnumber" text="{i18n>accNumber}" class="sapUiSmallMarginEnd"/>
                        <Text id="accval" text="00288**********" />
                    </HBox>
                    <HBox id="hBox12">
                        <Label id="lblAccHolderName" text="{i18n>accHolderName}" class="sapUiSmallMarginEnd"/>
                        <Text id="accountHolderNameVal" text="Sai Shankar Chaleendram" />
                    </HBox>
                    <HBox id="hBox3">
                        <Label id="lblIfsc" text="{i18n>iFSCode}" class="sapUiSmallMarginEnd"/>
                        <Text id="ifscVal" text="00001300" />
                    </HBox>
                    <Button id="openBankDetails" type="Neutral" text="{i18n>findMoreBtn}" press=".onOpenBankDetails" class="sapUiSmallMarginTop"/>
                </VBox>
            </HBox>
        </content>
    </Panel>
</core:FragmentDefinition>
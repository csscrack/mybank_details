<core:FragmentDefinition xmlns:core = "sap.ui.core"
    xmlns = "sap.m" xmlns:m="sap.suite.ui.microchart">

    <Panel id="pAccountDetails" expandable="false" width="auto" class="sapUiResponsiveMargin">
        <!-- headerText="Account Details"         - Removed as per the requirments -->
        <content>
            <HBox id="hBox4">
                <Avatar id="aUserProfile" src="{/profile}" displaySize="XL" showBorder="true" press=".onPress"/>
                <VBox id="vBox1" binding="{oBankDetails>/accountDetails}" class="sapUiSmallMargin sapUiLargeMarginBegin">
                    <!-- <Title id="accDetails" text="{i18n>accDetails}" /> -->
                    <HBox id="hBox1">
                        <Label id="lblAccnumber" text="{i18n>accNumber}" class="sapUiSmallMarginEnd"/>
                        <Text id="accval" text="{oBankDetails>accountNmbr}" />
                    </HBox>
                    <HBox id="hBox12">
                        <Label id="lblAccHolderName" text="{i18n>accHolderName}" class="sapUiSmallMarginEnd"/>
                        <Text id="accountHolderNameVal" text="{oBankDetails>name}" />
                    </HBox>
                    <HBox id="hBox3">
                        <Label id="lblIfsc" text="{i18n>iFSCode}" class="sapUiSmallMarginEnd"/>
                        <Text id="ifscVal" text="{oBankDetails>ifsc}" />
                    </HBox>
                    <Button id="openBankDetails" type="Neutral" text="{i18n>findMoreBtn}" press=".onOpenBankDetails" class="sapUiSmallMarginTop"/>
                </VBox>
                <FlexBox id="flexbox1" width="20rem" height="10rem" alignItems="Start" justifyContent="SpaceBetween">
                    <items>
                        <m:InteractiveDonutChart id="dunutChart" selectionChanged=".onSelectionChanged">
                            <m:segments>
                                <m:InteractiveDonutChartSegment id="chart1" 
                                    label="{i18n>houseSpending}" 
                                    value="{path:'oBankDetails>/houseSpending', formatter:'.formatter.getPercentage'}" 
                                    displayedValue="{path:'oBankDetails>/houseSpending', formatter:'.formatter.getPercentage'}%"
                                    color="{path:'oBankDetails>/houseSpending', formatter:'.formatter.getState'}"
                                    />
                                <m:InteractiveDonutChartSegment id="chart2" 
                                    label="{i18n>loanEMI}" 
                                    value="{path:'oBankDetails>/emi', formatter:'.formatter.getPercentage'}" 
                                    displayedValue="{path:'oBankDetails>/emi', formatter:'.formatter.getPercentage'}%"
                                    color="{path:'oBankDetails>/emi', formatter:'.formatter.getState'}"
                                    />
                                <m:InteractiveDonutChartSegment id="chart3" 
                                    label="{i18n>entertainment}" 
                                    value="{path:'oBankDetails>/entertainment', formatter:'.formatter.getPercentage'}"
                                    displayedValue="{path:'oBankDetails>/entertainment', formatter:'.formatter.getPercentage'}%"
                                    color="{path:'oBankDetails>/entertainment', formatter:'.formatter.getState'}"
                                    />
                            </m:segments>
                        </m:InteractiveDonutChart>
                    </items>
                </FlexBox>
            </HBox>
        </content>
    </Panel>
</core:FragmentDefinition>
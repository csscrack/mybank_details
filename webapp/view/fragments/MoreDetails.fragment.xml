<core:FragmentDefinition xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <Dialog id="moreBankDetails" title="{i18n>confiDetails}">
        <VBox id="vBox" binding="{/bankDetails}" class="sapUiSmallMargin">
            <HBox id="hBox">
                <Label id="lblAccnbr" text="{i18n>accNumber}" class="sapUiSmallMarginEnd"/>
                <Text id="accvalue" text="{accountNmbr}" />
            </HBox>
            <HBox id="hBoxx">
                <Label id="lbAccHolderName" text="{i18n>accHolderName}" class="sapUiSmallMarginEnd"/>
                <Text id="accHolderNameValue" text="{name}" />
            </HBox>
            <HBox id="hBoxxx">
                <Label id="lbIfsc" text="{i18n>iFSCode}" class="sapUiSmallMarginEnd"/>
                <Text id="ifscValue" text="{ifsc}" />
            </HBox>
            <HBox id="hBoxxxx">
                <Label id="lbCustomerId" text="{i18n>custID}" class="sapUiSmallMarginEnd"/>
                <Text id="customerIdValue" text="{customerId}" />
            </HBox>
            <HBox id="hBoxxxxxx">
                <Label id="lblAddess" text="{i18n>address}" class="sapUiSmallMarginEnd"/>
                <Text id="address" text="{address/houseNumber}, {address/street}, {address/city}, {address/state}, {address/country}, {address/postalCode}" />
            </HBox>
        </VBox>
        <beginButton>
            <Button id="closeButton" text="Close" press=".onCloseBankDetails"></Button>
        </beginButton>
    </Dialog>
</core:FragmentDefinition>